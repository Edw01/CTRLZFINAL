object FormularioVisorMP25: TFormularioVisorMP25
  Left = 180
  Height = 255
  Top = 180
  Width = 985
  Caption = 'By Alberto Caro'
  ClientHeight = 255
  ClientWidth = 985
  Color = clBtnFace
  Position = poScreenCenter
  ShowHint = True
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  LCLVersion = '4.8.0.0'
  object VisorGraficoMP25: TChart
    Left = 8
    Height = 240
    Top = 8
    Width = 968
    AxisList = <    
      item
        Grid.Color = clBlack
        Grid.Visible = False
        Intervals.MaxLength = 45
        Intervals.MinLength = 20
        Intervals.NiceSteps = '0.5'
        Intervals.Options = [aipUseMaxLength, aipUseMinLength, aipUseNiceSteps]
        Marks.LabelBrush.Style = bsClear
        Marks.Range.Max = 200
        Marks.Range.UseMax = True
        Marks.Range.UseMin = True
        Minors = <>
        Range.Max = 235
        Range.Min = -25
        Range.UseMax = True
        Range.UseMin = True
        Title.Distance = 4
        Title.LabelFont.Height = -13
        Title.LabelFont.Name = 'Segoe UI'
        Title.LabelFont.Orientation = 900
        Title.LabelFont.Style = [fsBold]
        Title.Visible = True
        Title.Caption = '[ug/m3]'
        Title.LabelBrush.Style = bsClear
      end    
      item
        Grid.Color = clBlack
        Grid.Visible = False
        Alignment = calBottom
        Intervals.MaxLength = 30
        Intervals.MinLength = 10
        Intervals.NiceSteps = '1'
        Intervals.Options = [aipUseMaxLength, aipUseMinLength, aipUseNiceSteps, aipInteger]
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Range.Max = 29
        Range.UseMax = True
        Range.UseMin = True
        Title.LabelBrush.Style = bsClear
      end>
    BackColor = clBtnFace
    Foot.Brush.Style = bsClear
    Foot.Font.Color = clBlack
    Foot.Font.Height = -12
    Foot.Font.Name = 'Segoe UI'
    Foot.Font.Style = [fsBold]
    Foot.Text.Strings = (
      'Sampling MP 2.5um'
    )
    Foot.Visible = True
    Frame.Color = clBlack
    Legend.BackgroundBrush.Color = clWhite
    Legend.Frame.Color = clBlack
    Legend.UseSidebar = True
    Legend.Visible = True
    Margins.Left = 0
    Margins.Top = 8
    Margins.Right = 0
    Margins.Bottom = 8
    Title.Brush.Style = bsClear
    Title.Font.Color = clBlack
    Title.Font.Height = -15
    Title.Font.Name = 'Segoe UI'
    Title.Font.Style = [fsBold]
    Title.Text.Strings = (
      'Material Particulado 2.5 um'
    )
    Title.Visible = True
    OnBeforeDrawBackWall = VisorGraficoMP25BeforeDrawBackWall
    object SerieLineaMP25: TLineSeries
      AxisIndexX = 1
      AxisIndexY = 0
      Legend.Multiplicity = lmSingle
      Title = 'MP 10 um'
      LinePen.Color = clRed
      Marks.Clipped = True
      Marks.Distance = 10
      Marks.Format = '%0:.0f'
      Marks.Frame.Color = clBlack
      Marks.Frame.Visible = True
      Marks.LabelBrush.Color = clWhite
      Marks.LabelBrush.Style = bsSolid
      Marks.LinkPen.Color = clWhite
      Marks.Style = smsValue
      Pointer.Brush.Color = clBlue
      Pointer.HorizSize = 4
      Pointer.OverrideColor = []
      Pointer.Pen.Color = clYellow
      Pointer.Style = psRectangle
      Pointer.VertSize = 4
      Pointer.Visible = True
      ShowPoints = True
    end
  end
  object BotonCapturarPantalla: TBitBtn
    Left = 735
    Height = 28
    Hint = 'Capturar imagen del visor en captura.png'
    Top = 6
    Width = 68
    Caption = 'Save'
    ParentShowHint = False
    ShowHint = True
    TabOrder = 1
    OnClick = BotonCapturarPantallaClick
  end
  object BotonAlternarGrilla: TBitBtn
    Left = 808
    Height = 28
    Hint = 'Activar / Desactivar la grilla del visor'
    Top = 6
    Width = 68
    Caption = 'On/off'
    ParentShowHint = False
    ShowHint = True
    TabOrder = 2
    OnClick = BotonAlternarGrillaClick
  end
  object BotonCambiarFondo: TBitBtn
    Left = 890
    Height = 40
