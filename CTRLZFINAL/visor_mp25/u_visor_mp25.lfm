    Top = 172
    Width = 76
    Caption = 'Click'
    ParentShowHint = False
    ShowHint = True
    TabOrder = 3
    OnClick = BotonCambiarFondoClick
  end
  object PuertoSerialMP25: TLazSerial
    Active = False
    BaudRate = br__9600
    DataBits = db8bits
    Parity = pNone
    FlowControl = fcNone
    StopBits = sbOne
    Device = 'COM2'
    RcvLineCRLF = True
    OnRxData = PuertoSerialMP25RxData
    Left = 40
    Top = 16
  end
  object TemporizadorSimulacion: TTimer
    Enabled = False
    Interval = 1000
    OnTimer = TemporizadorSimulacionTimer
    Left = 96
    Top = 16
  end
